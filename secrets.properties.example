# Copy to secrets.properties (gitignored) and set your own values.
#
# MANTEL_BASE_URL              bundled default origin the app talks to.
# MANTEL_ALLOWED_HOST_SUFFIX   Config.isAllowed() only accepts a Remote Config
#                              server_base_url whose host == this or ends with
#                              ".<this>". Keep it as tight as your DNS allows.
MANTEL_BASE_URL=https://nextcloud.example.com
MANTEL_ALLOWED_HOST_SUFFIX=example.com
